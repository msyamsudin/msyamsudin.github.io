---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('beyondCode')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Beyond Code | ${SITE_TITLE}`} description="Refleksi tentang kehidupan, filosofi, dan hal-hal di luar pemrograman." />
		<style>
			main {
				width: 960px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 4rem 1rem;
			}
			.blog-header {
				text-align: center;
				margin-bottom: 4rem;
			}
			.blog-header h1 {
				font-size: 3.5rem;
				margin-bottom: 1rem;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 2.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				transition: transform 0.3s ease;
			}
			ul li:hover {
				transform: translateY(-8px);
			}
			ul li:first-child {
				grid-column: span 2;
				margin-bottom: 1rem;
			}
			.post-card {
				display: block;
				text-decoration: none;
				height: 100%;
				padding: 0;
				overflow: hidden;
			}
			.image-container {
				width: 100%;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				border-radius: 16px;
				margin-bottom: 1.5rem;
				border: 1px solid var(--glass-border);
			}
			.image-container img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.5s ease;
			}
			ul li:hover img {
				transform: scale(1.05);
			}
			.content {
				padding: 0 0.5rem;
			}
			.title {
				margin: 0 0 0.5rem 0;
				color: var(--text-primary);
				line-height: 1.2;
				font-size: 1.75rem;
				transition: color 0.3s ease;
			}
			.post-card:hover .title {
				color: var(--accent-emerald);
			}
			ul li:first-child .title {
				font-size: 2.5rem;
			}
			.date {
				margin: 0;
				color: var(--text-secondary);
				font-weight: 500;
			}
			@media (max-width: 720px) {
				ul {
					grid-template-columns: 1fr;
					gap: 2rem;
				}
				ul li:first-child {
					grid-column: span 1;
				}
				.blog-header h1 {
					font-size: 2.5rem;
				}
				.title {
					font-size: 1.5rem;
				}
				ul li:first-child .title {
					font-size: 1.75rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="blog-header">
				<h1 class="primary-text">Beyond Code</h1>
				<p>Thinking about life, balance, and everything in between.</p>
			</section>
			<section>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/beyond-code/${post.id}/`} class="post-card">
									<div class="image-container glass">
										{post.data.heroImage && (
											<Image width={720} height={360} src={post.data.heroImage} alt="" />
										)}
									</div>
									<div class="content">
										<h4 class="title">{post.data.title}</h4>
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
